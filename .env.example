# База речи общая с speech-backend; миграции запускаются из speech-backend.
SPEECH_MS_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_WRITE_TRACE_ENABLED=false
SPEECH_DISPLAY_TIMEZONE=Europe/Moscow
SPEECH_WORKER_TEMP_DIR=/tmp/speech-worker

# MinIO находится на другом сервере. Указываем доступный этому хосту адрес.
SPEECH_STORAGE_BASE_URL=
SPEECH_STORAGE_BUCKET=speech-recordings
SPEECH_STORAGE_REGION=us-east-1
SPEECH_STORAGE_ACCESS_KEY_ID=
SPEECH_STORAGE_SECRET_KEY=
SPEECH_STORAGE_TIMEOUT_SECONDS=60

# Существующий Whisper/model-proxy по HTTP, адрес включает /v1.
SPEECH_WHISPER_BASE_URL=
SPEECH_WHISPER_API_KEY=
SPEECH_WHISPER_MODEL=large-v3
SPEECH_WHISPER_LANGUAGE=ru
SPEECH_WHISPER_TIMEOUT_SECONDS=600
SPEECH_WHISPER_VAD_FILTER=true

# NCC: local_export, reporting_view, sequence, storage или rest.
SPEECH_NCC_SOURCE_KIND=local_export
SPEECH_NCC_EXPORT_DIR=
SPEECH_NCC_BASE_URL=
SPEECH_NCC_USERNAME=
SPEECH_NCC_API_TOKEN=
SPEECH_NCC_TIMEOUT_SECONDS=60
SPEECH_NCC_MIN_TALK_SECONDS=10
SPEECH_NCC_PROJECTS=
SPEECH_NCC_SESSION_ANCHOR=
SPEECH_NCC_SESSION_DOMAINS=0,1,2,3
SPEECH_NCC_SESSION_NAUSS=0
SPEECH_NCC_REPORTING_DATABASE_URL=
SPEECH_NCC_REPORTING_DB_PASSWORD=
SPEECH_NCC_REPORTING_VIEWS=
SPEECH_NCC_REPORTING_TIMEZONE=Europe/Moscow

# Телфин включается только при наличии учётных данных источника.
SPEECH_TELPHIN_BASE_URL=https://apiproxy.telphin.ru
SPEECH_TELPHIN_APP_ID=
SPEECH_TELPHIN_APP_SECRET=
SPEECH_TELPHIN_TIMEOUT_SECONDS=60
SPEECH_TELPHIN_MIN_TALK_SECONDS=10
SPEECH_TELPHIN_EXCLUDED_EXTENSIONS=13240*000,13240*007,13240*444
SPEECH_TELPHIN_EXCLUDED_GROUPS=22001
SPEECH_TELPHIN_HISTORY_FROM=
SPEECH_TELPHIN_HISTORY_DAYS_PER_RUN=7
SPEECH_PHONE_HASH_PEPPER=

# Существующие HTTP-приложения Dify; этап analyze требует основной ключ.
SPEECH_DIFY_BASE_URL=
SPEECH_DIFY_APP_KEY=
SPEECH_DIFY_REASON_APP_KEY=
SPEECH_DIFY_CANDIDATE_APP_KEY=
SPEECH_DIFY_TIMEOUT_SECONDS=120

# Отдельная команда оценки продаж Телфина.
SPEECH_QUALITY_LLM_BASE_URL=
SPEECH_QUALITY_LLM_API_KEY=
SPEECH_QUALITY_LLM_MODEL=qwen3.8-27b-fast
SPEECH_QUALITY_LLM_TIMEOUT_SECONDS=180
SPEECH_QUALITY_LLM_MAX_TOKENS=4096
